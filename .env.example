# Environment configuration for Smart Phishing Detection Backend
APP_NAME="Smart Phishing Detection System"
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=info

# Security & Rate Limiting
CORS_ORIGINS="*"
ADMIN_API_KEY="change-this-to-a-strong-random-secret"
RATE_LIMIT_ANALYZE=30
RATE_LIMIT_HISTORY=60

# Google Cloud Firestore (Mount credential file externally via volume on VPS - NEVER commit JSON keys!)
FIRESTORE_PROJECT_ID=your-gcp-project-id
FIRESTORE_COLLECTION=phishing_scans
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firestore-service-account.json
